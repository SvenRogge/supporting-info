&GLOBAL
  PROJECT adsorption_sites
  RUN_TYPE GEO_OPT
  EXTENDED_FFT_LENGTHS T
  PREFERRED_FFT_LIBRARY FFTW3
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
 &DFT
      UKS  F
      MULTIPLICITY  1
      BASIS_SET_FILE_NAME  basis_set
      POTENTIAL_FILE_NAME  potential
      &SCF
         MAX_SCF  50
         MAX_DIIS 8
         EPS_SCF  1.0E-08
         SCF_GUESS  RESTART
         &OT
            MINIMIZER  CG
            PRECONDITIONER FULL_SINGLE_INVERSE
         &END OT
         &OUTER_SCF T
            MAX_SCF  160
            EPS_SCF  1.0E-08
         &END OUTER_SCF
         &PRINT
            &RESTART
               BACKUP_COPIES 0
               ADD_LAST NUMERIC
               COMMON_ITERATION_LEVELS 3
            &END RESTART
         &END PRINT
      &END SCF
      &QS
         METHOD  GPW
         EPS_DEFAULT 1.0E-10
         EXTRAPOLATION ASPC
      &END QS
      &MGRID
         REL_CUTOFF [Ry] 50
         NGRIDS  5
         CUTOFF [Ry] 1100
      &END MGRID
      &XC
         DENSITY_CUTOFF 1.0E-10
         GRADIENT_CUTOFF 1.0E-10
         TAU_CUTOFF 1.0E-10
         &XC_FUNCTIONAL
          &GGA_X_RPBE
          &END GGA_X_RPBE
         &END XC_FUNCTIONAL
         &VDW_POTENTIAL
            POTENTIAL_TYPE  PAIR_POTENTIAL
            &PAIR_POTENTIAL
               TYPE  DFTD3(BJ)
               PARAMETER_FILE_NAME  dftd3
               REFERENCE_FUNCTIONAL RPBE
               R_CUTOFF  25
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
      &END XC
 &END DFT
 &SUBSYS
	&KIND H
	 ELEMENT  H
	 BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
	 POTENTIAL GTH-PBE-q1
	&END KIND
	&KIND O
	 ELEMENT  O
	 BASIS_SET TZVP-MOLOPT-PBE-GTH-q6
	 POTENTIAL GTH-PBE-q6
	&END KIND
	&KIND Si
	 ELEMENT  Si
	 BASIS_SET TZVP-MOLOPT-PBE-GTH-q4
	 POTENTIAL GTH-PBE-q4
	&END KIND
	&KIND C
	 ELEMENT  C
	 BASIS_SET TZV2P-MOLOPT-PBE-GTH-q4
	 POTENTIAL GTH-PBE-q4
	&END KIND
	&KIND N
	 ELEMENT  N
	 BASIS_SET TZV2P-MOLOPT-PBE-GTH-q5
	 POTENTIAL GTH-PBE-q5
	&END KIND
	&KIND Al
	 ELEMENT  Al
	 BASIS_SET TZVP-MOLOPT-PBE-GTH-q3
	 POTENTIAL GTH-PBE-q3
	&END KIND
	&KIND Zn
	 ELEMENT  Zn
	 BASIS_SET TZV2P-MOLOPT-PBE-GTH-q12
	 POTENTIAL GTH-PBE-q12
	&END KIND
	&KIND Cs
	 ELEMENT  Cs
	 BASIS_SET TZV2P-MOLOPT-PBE-GTH-q9
	 POTENTIAL GTH-PBE-q9
	&END KIND
	&KIND Pb
	 ELEMENT  Pb
	 BASIS_SET TZV2P-MOLOPT-PBE-GTH-q4
	 POTENTIAL GTH-PBE-q4
	&END KIND
	&KIND I
	 ELEMENT  I
	 BASIS_SET TZV2P-MOLOPT-PBE-GTH-q7
	 POTENTIAL GTH-PBE-q7
	&END KIND
	&KIND Cl
	 ELEMENT  Cl
	 BASIS_SET TZV2P-MOLOPT-PBE-GTH-q7
	 POTENTIAL GTH-PBE-q7
	&END KIND
    &CELL
        A 17.077406	0.0	0.0
        B 5.21599745311e-05	17.07740799992034	0.0
        C 7.2725907343e-05	6.13995193216e-05	17.077407999734763
    &END CELL
    &TOPOLOGY
        COORDINATE XYZ
        COORD_FILE STRUCTPATH
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER  600
    MAX_DR    [bohr] 0.003
    MAX_FORCE [hartree*bohr^-1] 0.0001
    RMS_DR    [bohr] 0.0015
    RMS_FORCE [hartree*bohr^-1] 0.0003
  &END GEO_OPT
  &PRINT
    &TRAJECTORY
        FORMAT XYZ
        &EACH
            GEO_OPT 1
        &END EACH
    &END TRAJECTORY
    &RESTART_HISTORY
      &EACH
         GEO_OPT 500
      &END EACH
    &END RESTART_HISTORY
    &RESTART
        BACKUP_COPIES 3
        &EACH
            GEO_OPT 1
        &END EACH
    &END RESTART
    &CELL
    &END CELL
  &END PRINT
&END MOTION
#&EXT_RESTART
#   RESTART_FILE_NAME adsorption_sites-1.restart
#   RESTART_DEFAULT TRUE
#&END EXT_RESTART